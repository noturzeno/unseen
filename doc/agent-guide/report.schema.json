{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unseen.local/schemas/development-report.json",
  "title": "Unseen development report (input to `unseen report`)",
  "description": "Report of work done by a coding agent. Claims only; never verifies features. Must not contain secrets or personal data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 10000, "description": "What changed, in plain English." },
    "prompt": { "type": "string", "maxLength": 2000, "description": "What the agent was asked to do, in a sentence. No secrets or personal data." },
    "agent": { "type": "string", "maxLength": 100, "examples": ["claude-code"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "limitations": { "type": "string", "maxLength": 10000 },
    "reported_at": { "type": "string", "format": "date-time", "description": "Defaults to now; must not be in the future." },
    "git_branch": { "type": "string", "maxLength": 255, "description": "Filled automatically by the CLI." },
    "git_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$", "description": "Filled automatically by the CLI." },
    "diff_ref": { "type": "string", "maxLength": 2048 },
    "features": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "oneOf": [
          { "type": "integer", "minimum": 1, "description": "Feature id from `unseen status`." },
          { "type": "string", "minLength": 1, "description": "Exact feature name (case-insensitive)." },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "name": { "type": "string", "minLength": 1 },
              "status": { "enum": ["planned", "in_progress", "implemented", "blocked", "not_implemented"] },
              "note": { "type": "string", "maxLength": 2000 }
            },
            "anyOf": [{ "required": ["id"] }, { "required": ["name"] }]
          }
        ]
      }
    },
    "changed_files": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 1024 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "change": { "enum": ["added", "modified", "deleted", "renamed"] }
            }
          }
        ]
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "outcome"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "outcome": { "enum": ["passed", "failed", "error", "skipped", "not_run"] },
          "summary": { "type": "string", "maxLength": 5000 }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 100,
      "description": "Work left open, one item per entry. The object form says who has to act.",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 2000 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "waiting_on": { "enum": ["client", "team", "agent"], "description": "client: the client must decide or provide something. team: the user or their team must. agent: no decision needed." },
              "decision_note": { "type": "string", "maxLength": 2000, "description": "Exactly what is needed (for agent items: what to build)." }
            }
          }
        ]
      }
    },
    "resolves": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 },
      "description": "Ids of open unresolved items (from `unseen status`) that this work fully completed."
    },
    "tickets": {
      "type": "array",
      "maxItems": 100,
      "description": "Tickets this work moved or touched. Each gets a thread entry linked to the report.",
      "items": {
        "oneOf": [
          { "type": "integer", "minimum": 1, "description": "Ticket id." },
          { "type": "string", "minLength": 1, "description": "Ticket reference such as \"WEB-142\", or \"#id\"." },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "ref": { "type": "string", "minLength": 1 },
              "status": { "enum": ["open", "in_progress", "ready_for_qa", "qa_failed", "client_review", "changes_requested", "done", "closed"], "description": "Usually ready_for_qa. Later stages come from QA or the client." },
              "note": { "type": "string", "maxLength": 5000 }
            }
          }
        ]
      }
    }
  }
}
